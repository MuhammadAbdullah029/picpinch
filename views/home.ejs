<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Your PicPinch library — view and compress your photos.">
    <title>PicPinch</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/home.css">
</head>

<body>

    <!-- Flash Notifications -->
    <% if (locals.success_msg && success_msg.length > 0) { %>
        <p class="toast toast--success" role="status"><%= success_msg %></p>
    <% } %>

    <% if (locals.error_msg && error_msg.length > 0) { %>
        <p class="toast toast--error" role="alert"><%= error_msg %></p>
    <% } %>

    <% if (locals.error && error.length > 0) { %>
        <p class="toast toast--error" role="alert"><%= error %></p>
    <% } %>

    <% if (locals.errorMessage) { %>
        <p class="toast toast--error" role="alert"><%= errorMessage %></p>
    <% } %>

    <header class="site-header">
        <a class="brand" href="/picpinch">
            <svg class="brand__mark" width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <polyline points="4 14 10 14 10 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                <polyline points="20 10 14 10 14 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="14" y1="10" x2="21" y2="3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
                <line x1="3" y1="21" x2="10" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
            <span>PicPinch</span>
        </a>

        <nav class="site-header__actions" aria-label="Account actions">
            <a class="btn btn--primary" href="/picpinch/profile">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <polyline points="4 14 10 14 10 20" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <polyline points="20 10 14 10 14 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    <line x1="14" y1="10" x2="21" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <line x1="3" y1="21" x2="10" y2="14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
                Profile
            </a>
            <a class="btn btn--ghost" href="/api/v1/auth/logout">Log out</a>
        </nav>
    </header>

    <main class="shell">

        <section aria-label="Upload a photo">
            <form class="dropzone" id="compress-form" action="/api/v1/image/compress" method="post" enctype="multipart/form-data">

                <label class="dropzone__zone" id="dropzone-zone" for="image-input">
                    <svg class="dropzone__icon" width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <polyline points="4 14 10 14 10 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <polyline points="20 10 14 10 14 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                        <line x1="14" y1="10" x2="21" y2="3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                        <line x1="3" y1="21" x2="10" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                    <span class="dropzone__title">Drop a photo here to pinch it down</span>
                    <span class="dropzone__hint">or click to browse — JPG, PNG or WebP up to 20&nbsp;MB</span>
                    <input class="visually-hidden" type="file" id="image-input" name="image" accept="image/jpeg,image/png,image/webp" required>
                </label>

                <div class="dropzone__selected" id="dropzone-selected" hidden>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <circle cx="8.5" cy="9" r="1.4" stroke="currentColor" stroke-width="1.6" />
                        <path d="M3 15l5-4 4 3 3-2 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="dropzone__filename" id="dropzone-filename"></span>
                    <button type="button" class="dropzone__clear" id="dropzone-clear" aria-label="Remove selected photo">&times;</button>
                </div>

                <p class="dropzone__error" id="dropzone-error" role="alert" hidden></p>

                <button class="btn btn--primary dropzone__submit" type="submit">Pinch this photo</button>
            </form>
        </section>

        <section aria-label="Your photos">
            <div class="library__header">
                <h1>Your library</h1>
                <% if (locals.images && images.length) { %>
                    <p class="library__count"><%= images.length %> photo<%= images.length === 1 ? '' : 's' %></p>
                <% } %>
            </div>

            <% if (locals.images && images.length) { %>
                <div class="library__grid">
                    <% images.forEach(function(photo) { 
                        const publicUrl = photo.url.startsWith('public') ? photo.url.replace(/^public/, '') : photo.url;
                        const filename = photo.url.split('/').pop();
                    %>
                        <article class="photo-card">
                            <a href="/picpinch/image/<%= photo._id %>">
                                <div class="photo-card__thumb">
                                    <img src="<%= publicUrl %>" alt="<%= filename %>" loading="lazy">
                                </div>
                                <div class="photo-card__body">
                                    <p class="photo-card__name" title="<%= filename %>"><%= filename %></p>
                                    <div class="photo-card__meta">
                                        <% if (photo.savedPercent) { %>
                                            <span class="badge">Saved <%= photo.savedPercent %>%</span>
                                        <% } %>
                                    </div>
                                </div>
                            </a>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="empty-state">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="4" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6" />
                        <circle cx="8.5" cy="9" r="1.4" stroke="currentColor" stroke-width="1.6" />
                        <path d="M3 15l5-4 4 3 3-2 6 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <h2>Nothing pinched yet</h2>
                    <p>Upload a photo above and it'll show up here, pinched down to size.</p>
                </div>
            <% } %>
        </section>

    </main>

    <script src="/scripts/home.js" defer></script>

</body>

</html>